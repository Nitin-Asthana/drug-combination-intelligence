# Copy to .env and adjust. NEVER put API keys here — the app uses Microsoft
# Entra ID (run `az login`) via DefaultAzureCredential for Azure OpenAI.

# --- Azure OpenAI / Azure AI Foundry (identity-based auth) ---
# Leave blank to run in deterministic offline demo mode.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default
# gpt-5 / o-series latency controls:
# AZURE_OPENAI_REASONING_EFFORT=low        # minimal|low|medium|high (blank to disable)
# AZURE_OPENAI_MAX_TOKENS=3500

# --- Public API adapters (no keys required for basic use) ---
DCI_ENABLE_LIVE_RETRIEVAL=false
DCI_HTTP_TIMEOUT=20
DCI_HTTP_MAX_RETRIES=3
DCI_HTTP_BACKOFF_SECONDS=1.0
# Recommended by NCBI E-utilities etiquette:
# DCI_NCBI_EMAIL=you@example.com

# --- Optional: relocate the supplied data package ---
# DCI_DATA_ROOT=
